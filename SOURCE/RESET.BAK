RESETentry      CLI
	CLC
	XCE
	LongI
	LDX	#$1ff
	TXS
	ShortAI
	;Initial_Settings
	LDA	#$8F
	STA	|INIDISP
	STZ	|OBJSEL
	STZ	|OAMADDL
	STZ	|OAMADDH
	;STZ	|OAMDATA	; no need to write data
	STZ	|BGMODE
	STZ	|MOSAIC
	STZ	|BG1SC
	STZ	|BG2SC
	STZ	|BG3SC
	STZ	|BG4SC
	STZ	|BG12NBA
	STZ	|BG34NBA
	STZ	|BG1HOFS
	STZ	|BG1HOFS
	STZ	|BG1VOFS
	STZ	|BG1VOFS
	STZ	|BG2HOFS
	STZ	|BG2HOFS
	STZ	|BG2VOFS
	STZ	|BG2VOFS
	STZ	|BG3HOFS
	STZ	|BG3HOFS
	STZ	|BG3VOFS
	STZ	|BG3VOFS
	STZ	|BG4HOFS
	STZ	|BG4HOFS
	STZ	|BG4VOFS
	STZ	|BG4VOFS
	LDA	#$80
	STA	|VMAINC
	STZ	|VMADDL
	STZ	|VMADDH
	STZ	|M7SEL
	LDA	#$01
	STZ	|M7A
	STA	|M7A
	STZ	|M7B
	STZ	|M7B
	STZ	|M7C
	STZ	|M7C
	STZ	|M7D
	STA	|M7D
	STZ	|M7X
	STZ	|M7X
	STZ	|M7Y
	STZ	|M7Y
	STZ	|CGADD
	STZ	|W12SEL
	STZ	|W34SEL
	STZ	|WOBJSEL
	STZ	|WH0
	STZ	|WH1
	STZ	|WH2
	STZ	|WH3
	STZ	|WBGLOG
	STZ	|WOBJLOG
	STZ	|TM
	STZ	|TS
	STZ	|TMW
	LDA	#$30
	STA	|CGSWSEL
	STZ	|CGADSUB
	LDA	#$E0
	STA	|COLDATA
	STZ	|SETINI
	STZ	|NMITIMEN
	LDA	#$FF
	STA	|WRIO
	STZ	|WRMPYA
	STZ	|WRMPYB
	STZ	|WRDIVL
	STZ	|WRDIVH
	STZ	|WRDIVB
	STZ	|HTIMEL
	STZ	|HTIMEH
	STZ	|VTIMEL
	STZ	|VTIMEH
	STZ	|MDMAEN
	STZ	|HDMAEN
	LDA	#1	; fast ROM mode
	STA	|MEMSEL

	LongAI
	LDA	#$0000
	STA	>USER_RAM1
	STA	>USER_RAM2
	STA	<VARIABLES
	LDA	#$1FFF-1
	LDX	#VARIABLES
	TXY
	INY
	MVN	#SEG VARIABLES,#SEG VARIABLES	; dest , source
	LDA	#$FFFF-$2000-1
	LDX	#OFFSET USER_RAM1
	TXY
	INY
	MVN	#SEG USER_RAM1,#SEG USER_RAM1
	LDA	#$FFFF-1
	LDX	#OFFSET USER_RAM2
	TXY
	INY
	MVN	#SEG USER_RAM2,#SEG USER_RAM2

	LDA	#0	; init Direct Page
	TCD
	ASSUME	DATABANK FIRST_BANK AND $FF0000
	LDA	#SEG FIRST_BANK
	PHA
	PLB		; select data bank $00

	ShortA
	LDA	#$8F
	STA	<FADE
	STZ	<NMI_JUMP	; make sure first does nothing
	STZ	<SYNC	; fifty counter
	LongA

	; Set DMA channels for whateve I need (Kept as they are!)
	LDA	#$0108	; $2101 Object Area (test!)
	STA	|DMA_SETUP+DMA1

	LDA	#$2208	; $2122 CG-RAM, fixes byte
	STA	|DMA_SETUP+DMA2
	LDA	#$1809	; $2118 fixed addr for VRAMclear
	STA	|DMA_SETUP+DMA3

	LDA	#$2801	; $212E Window2 cords
	STA	|DMA_SETUP+DMA4	; use DMA 4 for H-DMA
	LDA	#$2641	; $212E Window2 cords
	STA	|DMA_SETUP+DMA0	; use DMA 4 for H-DMA

	LDA	#$0400	; $2104 OAM, byte store
	STA	|DMA_SETUP+DMA5	; use DMA 5
	LDA	#$2200	; $2122 CG-RAM, byte store
	STA	|DMA_SETUP+DMA6	; use DMA 6
	LDA	#$1801	; $2118 VRAM ,word write
	STA	|DMA_SETUP+DMA7	; use DMA 7

	; Clear VRAM & CG_RAM
	;LDA	#0 ;-1
	STZ	<ZAP_OUT	; POKE WITH 0's (should be 0)
	STZ	|VMADDL	; VRAM start @ 0
	LDX	#0
	STX	|CGDATA	; palette start @ 0
	STZ	|DMA_COUNT+DMA3	; amount 64k
	LDA	#512
	STA	|DMA_COUNT+DMA2
	LDA	#OFFSET ZAP_OUT
	STA	|DMA_A1ADDR+DMA3	; start address for read
	STA	|DMA_A1ADDR+DMA2
	LDX	#SEG ZAP_OUT	; bank 1 for character set
	STX	|DMA_A1ADDRB+DMA3
	STX	|DMA_A1ADDRB+DMA2
	LDX	#BIT3+BIT2
	STX	|MDMAEN	; set CLEAR going

	ASSUME	DATABANK COMMON_BANK AND $FF0000
	LDX	#64-2
INIT_DEB	LDA	#%0010110000000000
	LDA	#%0010000000000000

	STA	|LINE_BUFFER,X
	DEX
	DEX
	BPL	INIT_DEB
	LDA	#%10000001	; enable NMI, enable auto joy read
	STA	|NMITIMEN
